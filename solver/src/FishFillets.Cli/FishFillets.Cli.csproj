<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ffsolve</AssemblyName>
    <RootNamespace>FishFillets.Cli</RootNamespace>

    <!-- Native AOT: no JIT warm-up, no reflection, a single self-contained exe.
         `dotnet publish -r win-x64 -c Release` needs the MSVC linker (Visual
         Studio "Desktop development with C++" workload); a plain `dotnet build`
         / `dotnet run` works without it. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- For the one P/Invoke in WindowsLocale.cs: reading the Windows list and
         decimal separators, which InvariantGlobalization hides from .NET. The
         LibraryImport source generator emits unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FishFillets.Physics\FishFillets.Physics.csproj" />
    <ProjectReference Include="..\FishFillets.Search\FishFillets.Search.csproj" />
  </ItemGroup>

</Project>
